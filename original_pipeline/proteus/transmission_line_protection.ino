/*
 * transmission_line_protection.ino
 * --------------------------------
 * Phase 3 firmware scaffold for the Hybrid ANN-Proteus framework
 * (Blueprint v1.0, Section 3.2).  Target: Arduino Uno / ATmega328P in Proteus.
 *
 * STATUS: PENDING EXTERNAL EXECUTION.  This sketch compiles against the C
 * produced by MATLAB Coder (ann_predict.c/.h) and the scaler header emitted by
 * train_ann.py (scaler_params.h).  It has NOT been built, simulated or timed
 * in the present study, and no latency figure derived from it is reported.
 *
 * MEMORY BUDGET (computed, not measured)
 *   trainable parameters ............ 4,276
 *   int8 weights in PROGMEM ......... 4,276 B  of 32,768 B flash   (13.0 %)
 *   float32 weights (if not quantised) 17,104 B of 32,768 B flash  (52.2 %)
 *   activations, float32 ............ (24+64+32+16+4) x 4 = 560 B
 *   ATmega328P SRAM ................. 2,048 B
 *   => weights MUST be held in PROGMEM; SRAM holds activations only.
 *   Verify the true figures against the Proteus/avr-size report before
 *   citing them as measured.
 *
 * SAMPLING NOTE
 *   The ANN was trained on ONE scalar sample per channel. A deployed relay
 *   should instead compute window features (RMS, peak, sequence quantities,
 *   FFT/THD/DWT) over a rolling buffer. The circular buffer below is provided
 *   for that purpose; with WINDOW = 1 it reproduces the trained representation
 *   exactly, which is what must be used for any MATLAB/Proteus agreement test.
 */

#include <avr/pgmspace.h>
#include "ann_predict.h"     /* generated by validate_generate_c.m */
#include "scaler_params.h"   /* generated by train_ann.py          */

/* ------------------------------------------------------------ pin mapping */
const uint8_t PIN_IA = A0, PIN_IB = A1, PIN_IC = A2;   /* ACS712  x3 */
const uint8_t PIN_VA = A3, PIN_VB = A4, PIN_VC = A5;   /* ZMPT101B x3 */
const uint8_t LED_G = 8, LED_C = 9, LED_B = 10, LED_A = 11;
const uint8_t PIN_TRIP = 12;                           /* relay driver */

/* ------------------------------------------- sensor conditioning constants */
/* [USER INPUT REQUIRED] Calibrate against the Proteus sensor models.
 * ACS712-30A  : 66 mV/A, 2.5 V offset.  ZMPT101B: set by the divider network.
 * The dataset currents reach ~900 A, far beyond an ACS712; a matched CT ratio
 * or a rescaled sensor model must be declared before any agreement claim. */
const float ADC_LSB      = 5.0f / 1023.0f;
const float I_OFFSET_V   = 2.5f;
const float I_SENS_V_PER_A = 0.066f;
const float I_CT_RATIO   = 1.0f;   /* [USER INPUT REQUIRED] */
const float V_SCALE      = 1.0f;   /* [USER INPUT REQUIRED] */

#define WINDOW      1       /* 1 = reproduce the trained scalar representation */
#define N_FEAT      24

static float bufI[3][WINDOW], bufV[3][WINDOW];
static uint8_t head = 0;

static inline float readCurrent(uint8_t pin) {
  return ((analogRead(pin) * ADC_LSB) - I_OFFSET_V) / I_SENS_V_PER_A * I_CT_RATIO;
}
static inline float readVoltage(uint8_t pin) {
  return ((analogRead(pin) * ADC_LSB) - I_OFFSET_V) * V_SCALE;
}

/* ------------------------------------------------------- feature extraction
 * Mirrors build_rowwise_features() in feature_engineering.py EXACTLY.
 * Order must match FEATURE_NAMES; any divergence invalidates the scaler. */
void extract_features(float Ia, float Ib, float Ic,
                      float Va, float Vb, float Vc, float *f) {
  const float A_RE = -0.5f, A_IM = 0.8660254038f;   /* a = exp(j2pi/3) */

  f[0]=Ia; f[1]=Ib; f[2]=Ic; f[3]=Va; f[4]=Vb; f[5]=Vc;
  f[6]=fabs(Ia); f[7]=fabs(Ib); f[8]=fabs(Ic);
  f[9]=fabs(Va); f[10]=fabs(Vb); f[11]=fabs(Vc);
  f[12]=sqrt((Ia*Ia + Ib*Ib + Ic*Ic)/3.0f);
  f[13]=sqrt((Va*Va + Vb*Vb + Vc*Vc)/3.0f);
  f[14]=fmax(fabs(Ia), fmax(fabs(Ib), fabs(Ic)));
  f[15]=fmax(fabs(Va), fmax(fabs(Vb), fabs(Vc)));
  f[16]=(Ia + Ib + Ic)/3.0f;
  f[17]=(Va + Vb + Vc)/3.0f;

  /* negative sequence: (x_a + a^2 x_b + a x_c)/3 ; a^2 = conj(a) */
  f[18]=(Ia + (A_RE*Ib) + (A_RE*Ic))/3.0f;
  f[19]=((-A_IM*Ib) + (A_IM*Ic))/3.0f;
  f[20]=(Va + (A_RE*Vb) + (A_RE*Vc))/3.0f;
  f[21]=((-A_IM*Vb) + (A_IM*Vc))/3.0f;

  float m=(Ia+Ib+Ic)/3.0f;
  f[22]=sqrt(((Ia-m)*(Ia-m) + (Ib-m)*(Ib-m) + (Ic-m)*(Ic-m))/3.0f);
  f[23]=Va*Ia + Vb*Ib + Vc*Ic;
}

void setup() {
  Serial.begin(9600);
  pinMode(LED_G,OUTPUT); pinMode(LED_C,OUTPUT);
  pinMode(LED_B,OUTPUT); pinMode(LED_A,OUTPUT);
  pinMode(PIN_TRIP,OUTPUT);
  digitalWrite(PIN_TRIP,LOW);
  Serial.println(F("ANN relay ready"));
}

void loop() {
  float Ia=readCurrent(PIN_IA), Ib=readCurrent(PIN_IB), Ic=readCurrent(PIN_IC);
  float Va=readVoltage(PIN_VA), Vb=readVoltage(PIN_VB), Vc=readVoltage(PIN_VC);

  bufI[0][head]=Ia; bufI[1][head]=Ib; bufI[2][head]=Ic;
  bufV[0][head]=Va; bufV[1][head]=Vb; bufV[2][head]=Vc;
  head = (head + 1) % WINDOW;

  float feat[N_FEAT];
  extract_features(Ia,Ib,Ic,Va,Vb,Vc,feat);

  /* min-max normalisation with the TRAINING-SET parameters */
  for (uint8_t i=0;i<N_FEAT;i++) {
    float d = scaler_max[i] - scaler_min[i];
    feat[i] = (d > 1e-12f) ? (feat[i] - scaler_min[i]) / d : 0.0f;
    if (feat[i] < 0.0f) feat[i] = 0.0f;      /* clip as MinMaxScaler does not */
    if (feat[i] > 1.0f) feat[i] = 1.0f;      /* but the MCU should, for safety */
  }

  boolean_T flags[4];
  ann_predict(feat, flags);                  /* [G C B A] */

  digitalWrite(LED_G,flags[0]); digitalWrite(LED_C,flags[1]);
  digitalWrite(LED_B,flags[2]); digitalWrite(LED_A,flags[3]);

  if (flags[0]||flags[1]||flags[2]||flags[3]) {
    digitalWrite(PIN_TRIP,HIGH);
    Serial.print(F("TRIP,"));
    Serial.print(flags[0]); Serial.print(flags[1]);
    Serial.print(flags[2]); Serial.println(flags[3]);
  } else {
    digitalWrite(PIN_TRIP,LOW);
    Serial.println(F("OK,0000"));
  }
  delay(10);   /* 10 ms loop; see Blueprint 3.4 on latency budgeting */
}
